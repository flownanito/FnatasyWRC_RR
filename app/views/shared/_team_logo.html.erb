<% 
  logo_id = identifier.presence || 'apex'
  is_url = logo_id.starts_with?('http')
%>

<% if is_url %>
  <img src="<%= logo_id %>" alt="Team Logo" class="<%= local_assigns[:svg_class] || 'w-16 h-16' %> object-contain">
<% else %>
  <% case logo_id %>
  <% when 'apex' %>
    <!-- Apex: Sharp geometric A / upward chevron -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M50 15L85 85H65L50 55L35 85H15L50 15Z" fill="currentColor" opacity="0.9"/>
      <path d="M50 35L60 55H40L50 35Z" fill="currentColor" opacity="0.3"/>
    </svg>

  <% when 'vector' %>
    <!-- Vector: Forward-leaning arrows -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 20L60 50L20 80L35 50L20 20Z" fill="currentColor" opacity="0.5"/>
      <path d="M45 20L85 50L45 80L60 50L45 20Z" fill="currentColor" opacity="1.0"/>
    </svg>

  <% when 'shield' %>
    <!-- Shield: Angular futuristic shield -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M50 10L90 25V55C90 75 72 90 50 95C28 90 10 75 10 55V25L50 10Z" stroke="currentColor" stroke-width="8" stroke-linejoin="bevel"/>
      <path d="M50 25L75 35V55C75 70 65 80 50 85L50 25Z" fill="currentColor" opacity="0.7"/>
    </svg>

  <% when 'pulse' %>
    <!-- Pulse: Aggressive telemetry RPM spike -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 50H30L45 15L65 85L80 50H95" stroke="currentColor" stroke-width="10" stroke-linejoin="miter" stroke-miterlimit="4"/>
    </svg>

  <% when 'turbine' %>
    <!-- Turbine: Angular spinning turbo -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="35" stroke="currentColor" stroke-width="8"/>
      <path d="M50 15L55 45L85 50L55 55L50 85L45 55L15 50L45 45L50 15Z" fill="currentColor" opacity="0.9"/>
      <circle cx="50" cy="50" r="10" fill="none" stroke="currentColor" stroke-width="4"/>
    </svg>

  <% when 'wing' %>
    <!-- Wing: Aerodynamic geometric slices -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 80L90 20L80 80H10Z" fill="currentColor" opacity="0.4"/>
      <path d="M10 65L80 20L65 65H10Z" fill="currentColor" opacity="0.7"/>
      <path d="M10 50L65 20L45 50H10Z" fill="currentColor" opacity="1.0"/>
    </svg>

  <% else %>
    <!-- Default Badge -->
    <svg class="<%= local_assigns[:svg_class] || 'w-16 h-16' %>" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="20" y="20" width="60" height="60" stroke="currentColor" stroke-width="8" transform="rotate(45 50 50)"/>
      <circle cx="50" cy="50" r="10" fill="currentColor"/>
    </svg>
  <% end %>
<% end %>
