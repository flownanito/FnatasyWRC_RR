<div class="p-8 opacity-0 animate-fade-in-up">
  <div class="mb-8">
    <%= link_to "← Volver a Equipos", teams_path, class: "text-blue-400 hover:text-blue-300 text-sm font-bold uppercase tracking-wider transition-colors mb-6 inline-block" %>
    <h1 class="text-5xl font-black uppercase italic text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-400"><%= @team.name %></h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Drivers -->
    <div>
      <h2 class="text-2xl font-bold text-white mb-6 uppercase border-b border-zinc-800/50 pb-2 flex items-center gap-2">
        <span class="text-blue-500 drop-shadow-[0_0_10px_rgba(59,130,246,0.8)]">🏁</span> Pilotos Oficiales
      </h2>
      <div class="space-y-4">
        <% @team.drivers.each_with_index do |driver, index| %>
          <div class="glass-panel rounded-xl p-5 flex justify-between items-center group opacity-0 animate-fade-in-up" style="animation-delay: <%= (index * 100) % 1000 %>ms">
            <div>
              <h3 class="font-bold text-white text-lg group-hover:text-blue-400 transition-colors"><%= driver.name %></h3>
              <span class="px-2 py-0.5 bg-zinc-950/80 text-[10px] uppercase text-zinc-400 rounded-md border border-zinc-800/50 mt-1 inline-block shadow-inner"><%= driver.category %></span>
            </div>
            <div class="text-right">
              <span class="text-xs text-zinc-500 uppercase tracking-widest block mb-1 font-bold">Valor</span>
              <span class="font-mono text-green-400 font-bold group-hover:scale-110 transition-transform origin-right inline-block"><%= number_to_currency(driver.price, unit: '€', precision: 0) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Cars -->
    <div>
      <h2 class="text-2xl font-bold text-white mb-6 uppercase border-b border-zinc-800/50 pb-2 flex items-center gap-2">
        <span class="text-indigo-500 drop-shadow-[0_0_10px_rgba(99,102,241,0.8)]">🏎️</span> Vehículos
      </h2>
      <div class="space-y-4">
        <% @team.cars.each_with_index do |car, index| %>
          <div class="glass-panel rounded-xl p-5 flex justify-between items-center group opacity-0 animate-fade-in-up" style="animation-delay: <%= (index * 100) % 1000 %>ms">
            <div>
              <h3 class="font-bold text-white text-lg group-hover:text-indigo-400 transition-colors"><%= car.name %></h3>
              <div class="flex gap-1 mt-2">
                <% car.performance_bonus.times do %>
                  <div class="w-2 h-3 bg-indigo-500 rounded-sm shadow-[0_0_5px_rgba(99,102,241,0.8)]"></div>
                <% end %>
                <% (5 - car.performance_bonus).times do %>
                  <div class="w-2 h-3 bg-zinc-800/80 rounded-sm"></div>
                <% end %>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs text-zinc-500 uppercase tracking-widest block mb-1 font-bold">Valor</span>
              <span class="font-mono text-green-400 font-bold group-hover:scale-110 transition-transform origin-right inline-block"><%= number_to_currency(car.price, unit: '€', precision: 0) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
