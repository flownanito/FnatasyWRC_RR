<div class="p-8 opacity-0 animate-fade-in-up">
  <div class="mb-12 relative flex justify-between items-end border-b border-zinc-800/50 pb-6">
    <div>
      <div class="absolute -right-10 top-2 w-32 h-32 bg-blue-500/20 blur-[50px] rounded-full pointer-events-none"></div>
      <h1 class="text-4xl font-black uppercase italic text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-indigo-400 relative z-10">Equipos Oficiales</h1>
      <p class="text-zinc-400 mt-2 relative z-10">Directorios de escuderías, pilotos y vehículos del WRC 2026.</p>
    </div>
    <%= link_to "+ CREAR ESCUDERÍA", new_team_path, class: "bg-blue-600/20 hover:bg-blue-600/40 text-blue-400 border border-blue-500/30 font-mono text-xs px-4 py-2 rounded uppercase tracking-widest transition-colors relative z-10" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    <% @teams.where(user_id: nil).each_with_index do |team, index| %>
      <%= link_to team_path(team), class: "glass-panel rounded-2xl overflow-hidden hover:shadow-[0_0_30px_rgba(59,130,246,0.2)] hover:border-blue-500/50 transition-all group hover:-translate-y-1 block opacity-0 animate-fade-in-up", style: "animation-delay: #{(index * 100) % 1000}ms;" do %>
        <div class="p-6">
          <div class="h-20 mb-6 flex items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 group-hover:bg-white/10 transition-colors">
            <% if team.logo.present? %>
              <img src="<%= team.logo %>" alt="<%= team.name %>" class="max-h-full max-w-full object-contain filter drop-shadow-md group-hover:scale-110 transition-transform">
            <% else %>
              <div class="text-3xl text-zinc-500 font-black">?</div>
            <% end %>
          </div>
          <h2 class="text-2xl font-black text-white mb-2 group-hover:text-blue-400 transition-colors"><%= team.name %></h2>
          
          <div class="flex gap-4 mt-6 pt-6 border-t border-zinc-800/50 relative">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-500/20 to-transparent"></div>
            <div class="flex-1 bg-zinc-950/40 rounded-lg p-3 border border-zinc-800/30 text-center">
              <span class="block text-xl font-mono text-zinc-300 group-hover:text-white transition-colors"><%= team.drivers.count %></span>
              <span class="text-[10px] text-zinc-500 uppercase tracking-widest font-bold">Pilotos</span>
            </div>
            <div class="flex-1 bg-zinc-950/40 rounded-lg p-3 border border-zinc-800/30 text-center">
              <span class="block text-xl font-mono text-zinc-300 group-hover:text-white transition-colors"><%= team.cars.count %></span>
              <span class="text-[10px] text-zinc-500 uppercase tracking-widest font-bold">Coches</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @teams.where.not(user_id: nil).any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-black uppercase italic text-zinc-300">Escuderías de la Comunidad</h2>
      <p class="text-zinc-500 mt-1 text-sm">Equipos creados por otros mánagers.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% @teams.where.not(user_id: nil).each do |team| %>
        <%= link_to team_path(team), class: "glass-panel rounded-xl overflow-hidden hover:border-zinc-500 transition-all group block" do %>
          <div class="p-5">
            <h3 class="font-bold text-white group-hover:text-zinc-300 transition-colors text-lg truncate"><%= team.name %></h3>
            <p class="text-xs text-zinc-500 font-mono mt-2">Mánager: <%= team.user&.username || "Desconocido" %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
