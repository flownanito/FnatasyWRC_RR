<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= current_user&.theme == 'dark' || !user_signed_in? ? 'dark' : '' %>">
  <head>
    <title>WrcFantasy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white font-sans antialiased overflow-hidden transition-colors duration-300">
    <% if user_signed_in? %>
      <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 border-r flex flex-col hidden md:flex transition-colors bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800">
          <div class="h-16 flex items-center px-6 border-b border-zinc-200 dark:border-zinc-800">
            <span class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-orange-500 dark:from-red-500 dark:to-orange-400 italic tracking-tighter">WRC FANTASY</span>
          </div>
          
          <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors group #{current_page?(root_path) || current_page?(dashboard_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
              <%= t('menu.dashboard') %>
            <% end %>

            <%= link_to markets_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors group #{current_page?(markets_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              <%= t('menu.market') %>
            <% end %>

            <%= link_to calendars_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors group #{current_page?(calendars_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <%= t('menu.calendar') %>
            <% end %>

            <%= link_to teams_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors group #{current_page?(teams_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              <%= t('menu.teams') %>
            <% end %>

            <%= link_to settings_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors group #{current_page?(settings_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <%= t('menu.settings') %>
            <% end %>
          </nav>

          <div class="p-4 border-t border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 flex items-center justify-center text-sm font-bold text-red-600 dark:text-red-400">
                <%= current_user.email[0].upcase %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-zinc-900 dark:text-white truncate"><%= current_user.username || current_user.email %></p>
                <p class="text-xs text-emerald-600 dark:text-emerald-400 font-mono truncate"><%= number_to_currency(current_user.budget, unit: "€", precision: 0) %></p>
              </div>
            </div>
            <div class="mt-4">
              <%= button_to t('menu.logout'), destroy_user_session_path, method: :delete, class: "w-full text-left text-xs font-medium text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors" %>
            </div>
          </div>
        </aside>

        <!-- Main content -->
        <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-zinc-50 dark:bg-zinc-950 relative">
          <!-- Cinematic Ambient Glows -->
          <div class="absolute top-[-200px] right-[-100px] w-[500px] h-[500px] bg-red-600/10 blur-[120px] rounded-full pointer-events-none z-0"></div>
          <div class="absolute bottom-[-200px] left-[100px] w-[600px] h-[600px] bg-orange-600/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

          <div class="relative z-10 w-full h-full flex flex-col">
            <% if flash[:notice] %>
              <div class="absolute top-4 right-4 z-50 bg-emerald-100 dark:bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-400 px-4 py-3 rounded-lg shadow-lg backdrop-blur-md animate-slide-in-right">
                <%= notice %>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="absolute top-4 right-4 z-50 bg-red-100 dark:bg-red-500/10 border border-red-500/20 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg shadow-lg backdrop-blur-md animate-slide-in-right">
                <%= alert %>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <main class="min-h-screen bg-zinc-950 flex flex-col">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
