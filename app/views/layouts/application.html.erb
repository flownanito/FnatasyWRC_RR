<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= current_user&.theme == 'dark' || !user_signed_in? ? 'dark' : '' %>">
  <head>
    <title>WrcFantasy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="antialiased bg-zinc-950 text-white min-h-screen font-sans selection:bg-red-500/30">
    <% if current_user %>
      <div class="flex h-screen overflow-hidden text-zinc-900 dark:text-zinc-100">
        
        <!-- MOBILE MENU OVERLAY & SLIDE-OUT -->
        <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden md:hidden transition-opacity" onclick="toggleMobileMenu()"></div>
        <aside id="mobile-menu" class="fixed inset-y-0 left-0 w-72 bg-white dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 z-50 transform -translate-x-full transition-transform duration-300 md:hidden flex flex-col shadow-2xl">
          <div class="h-16 flex items-center justify-between px-6 border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 bg-zinc-900 dark:bg-white rounded-sm flex items-center justify-center transform -skew-x-12 shadow-sm">
                <span class="text-white dark:text-zinc-900 font-black italic text-sm tracking-tighter">W</span>
              </div>
              <div class="flex flex-col justify-center">
                <span class="text-[15px] font-black italic tracking-tighter text-zinc-900 dark:text-white leading-none">WRC</span>
                <span class="text-[8px] font-bold tracking-[0.2em] text-red-600 dark:text-red-500 leading-none mt-0.5">FANTASY</span>
              </div>
            </div>
            <button onclick="toggleMobileMenu()" class="p-2 text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          
          <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <%= link_to root_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(root_path) || current_page?(dashboard_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
              <%= t('menu.dashboard') %>
            <% end %>
            <% market_path = @current_league ? market_league_path(@current_league) : '#' %>
            <%= link_to market_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{(@current_league && current_page?(market_path)) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'} #{!@current_league && 'opacity-50 cursor-not-allowed pointer-events-none'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              <%= t('menu.market') %>
            <% end %>
            <%= link_to calendars_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(calendars_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <%= t('menu.calendar') %>
            <% end %>
            <%= link_to teams_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(teams_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              <%= t('menu.teams') %>
            <% end %>
            <%= link_to rules_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(rules_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
              <%= t('menu.rules', default: 'Normativa') %>
            <% end %>
            <%= link_to settings_path, onclick: "toggleMobileMenu()", class: "flex items-center gap-3 px-3 py-3 rounded-xl font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(settings_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <%= t('menu.settings') %>
            <% end %>
          </nav>

          <div class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/30">
            <div class="flex items-center gap-3">
              <!-- Avatar -->
              <div class="w-10 h-10 rounded-sm bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-black text-lg border-l-2 border-red-500 shrink-0 overflow-hidden relative group">
                <% if current_user.avatar.attached? %>
                  <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                <% else %>
                  <span class="text-zinc-500 dark:text-zinc-400"><%= current_user.email[0].upcase %></span>
                <% end %>
              </div>
              
              <!-- Info -->
              <div class="min-w-0 flex-1">
                <p class="text-[9px] font-mono text-zinc-500 uppercase tracking-widest mb-0.5">Manager Profile</p>
                <p class="text-xs font-bold font-mono uppercase tracking-wider text-zinc-900 dark:text-white truncate leading-none mb-1"><%= current_user.username || current_user.email.split('@').first %></p>
                
                <% if @league && @member %>
                  <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono truncate leading-none"><%= number_to_currency(@member.budget, unit: "€", precision: 0) %></p>
                <% else %>
                  <p class="text-[10px] text-blue-600 dark:text-blue-400 font-mono truncate leading-none"><%= current_user.league_members.sum(:total_points) || 0 %> PTS GLB</p>
                <% end %>
              </div>
            </div>
            
            <div class="mt-4">
              <%= button_to t('menu.logout'), destroy_user_session_path, method: :delete, class: "w-full text-left text-xs font-bold font-mono text-[10px] uppercase tracking-widest text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors flex items-center gap-2" %>
            </div>
          </div>
        </aside>

        <!-- DESKTOP Sidebar (Hidden on mobile) -->
        <aside class="hidden md:flex w-64 flex-shrink-0 bg-white dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 flex-col z-20 shadow-[4px_0_24px_rgba(0,0,0,0.02)] dark:shadow-[4px_0_24px_rgba(0,0,0,0.2)]">
          <div class="h-16 flex items-center px-6 border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-2.5 hover:opacity-80 transition-opacity cursor-default">
              <div class="w-8 h-8 bg-zinc-900 dark:bg-white rounded-sm flex items-center justify-center transform -skew-x-12 shadow-sm">
                <span class="text-white dark:text-zinc-900 font-black italic text-lg tracking-tighter">W</span>
              </div>
              <div class="flex flex-col justify-center">
                <span class="text-[17px] font-black italic tracking-tighter text-zinc-900 dark:text-white leading-none">WRC</span>
                <span class="text-[9px] font-bold tracking-[0.25em] text-red-600 dark:text-red-500 leading-none mt-0.5">FANTASY</span>
              </div>
            </div>
          </div>
          
          <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(root_path) || current_page?(dashboard_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
              <%= t('menu.dashboard') %>
            <% end %>

            <% market_path = @current_league ? market_league_path(@current_league) : '#' %>
            <%= link_to market_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{(@current_league && current_page?(market_path)) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'} #{!@current_league && 'opacity-50 cursor-not-allowed pointer-events-none'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              <%= t('menu.market') %>
            <% end %>

            <%= link_to calendars_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(calendars_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <%= t('menu.calendar') %>
            <% end %>

            <%= link_to teams_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(teams_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              <%= t('menu.teams') %>
            <% end %>

            <%= link_to rules_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(rules_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
              <%= t('menu.rules', default: 'Normativa') %>
            <% end %>

            <%= link_to settings_path, class: "flex items-center gap-3 px-3 py-2 rounded-md font-bold font-mono text-[10px] uppercase tracking-widest transition-colors group #{current_page?(settings_path) ? 'bg-red-600/10 text-red-600 dark:text-red-500' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800'}" do %>
              <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <%= t('menu.settings') %>
            <% end %>
          </nav>

          <div class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/30">
            <div class="flex items-center gap-3">
              <!-- Avatar -->
              <div class="w-10 h-10 rounded-sm bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-black text-lg border-l-2 border-red-500 shrink-0 overflow-hidden relative group">
                <% if current_user.avatar.attached? %>
                  <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                <% else %>
                  <span class="text-zinc-500 dark:text-zinc-400"><%= current_user.email[0].upcase %></span>
                <% end %>
              </div>
              
              <!-- Info -->
              <div class="min-w-0 flex-1">
                <p class="text-[9px] font-mono text-zinc-500 uppercase tracking-widest mb-0.5">Manager Profile</p>
                <p class="text-xs font-bold font-mono uppercase tracking-wider text-zinc-900 dark:text-white truncate leading-none mb-1"><%= current_user.username || current_user.email.split('@').first %></p>
                
                <% if @league && @member %>
                  <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono truncate leading-none"><%= number_to_currency(@member.budget, unit: "€", precision: 0) %></p>
                <% else %>
                  <p class="text-[10px] text-blue-600 dark:text-blue-400 font-mono truncate leading-none"><%= current_user.league_members.sum(:total_points) || 0 %> PTS GLB</p>
                <% end %>
              </div>
            </div>
            
            <div class="mt-4">
              <%= button_to t('menu.logout'), destroy_user_session_path, method: :delete, class: "w-full text-left text-xs font-bold font-mono text-[10px] uppercase tracking-widest text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors flex items-center gap-2" %>
            </div>
          </div>
        </aside>

        <!-- Main content -->
        <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-zinc-50 dark:bg-zinc-950 relative">
          
          <!-- MOBILE HEADER (visible only on md and smaller) -->
          <div class="md:hidden sticky top-0 z-30 w-full h-16 flex items-center justify-between px-4 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-xl border-b border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 bg-zinc-900 dark:bg-white rounded-sm flex items-center justify-center transform -skew-x-12 shadow-sm">
                <span class="text-white dark:text-zinc-900 font-black italic text-sm tracking-tighter">W</span>
              </div>
              <div class="flex flex-col justify-center">
                <span class="text-[15px] font-black italic tracking-tighter text-zinc-900 dark:text-white leading-none">WRC</span>
                <span class="text-[8px] font-bold tracking-[0.2em] text-red-600 dark:text-red-500 leading-none mt-0.5">FANTASY</span>
              </div>
            </div>
            <button onclick="toggleMobileMenu()" class="p-2 -mr-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
          </div>

          <!-- Cinematic Ambient Glows -->
          <div class="absolute top-[-200px] right-[-100px] w-[500px] h-[500px] bg-red-600/10 blur-[120px] rounded-full pointer-events-none z-0"></div>
          <div class="absolute bottom-[-200px] left-[100px] w-[600px] h-[600px] bg-orange-600/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

          <div class="relative z-10 w-full flex-1 flex flex-col pb-8 md:pb-0">
            <% if flash[:notice] %>
              <div class="absolute top-6 right-6 z-50 bg-zinc-950/90 border-l-4 border-emerald-500 p-4 shadow-[0_0_30px_rgba(16,185,129,0.15)] animate-slide-in-right flex items-start gap-4 mx-4 md:mx-0 mt-16 md:mt-0 max-w-sm backdrop-blur-md rounded-r-lg">
                <div class="pt-1">
                  <i class="fa-solid fa-check text-emerald-500 text-xl drop-shadow-[0_0_8px_rgba(16,185,129,0.8)]"></i>
                </div>
                <div>
                  <p class="text-[9px] font-mono text-emerald-500 uppercase tracking-[0.2em] mb-1">Telemetry Update</p>
                  <p class="text-xs font-bold font-mono text-white leading-relaxed uppercase tracking-wider"><%= notice %></p>
                </div>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="absolute top-6 right-6 z-50 bg-zinc-950/90 border-l-4 border-red-600 p-4 shadow-[0_0_30px_rgba(220,38,38,0.2)] animate-slide-in-right flex items-start gap-4 mx-4 md:mx-0 mt-16 md:mt-0 max-w-sm backdrop-blur-md rounded-r-lg">
                <div class="pt-1">
                  <i class="fa-solid fa-triangle-exclamation text-red-500 text-xl animate-pulse drop-shadow-[0_0_8px_rgba(239,68,68,0.8)]"></i>
                </div>
                <div>
                  <p class="text-[9px] font-mono text-red-500 uppercase tracking-[0.2em] mb-1 drop-shadow-[0_0_5px_rgba(239,68,68,0.5)]">System Alert</p>
                  <p class="text-xs font-bold font-mono text-white leading-relaxed uppercase tracking-wider"><%= alert %></p>
                </div>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>

      <script>
        function toggleMobileMenu() {
          const menu = document.getElementById('mobile-menu');
          const overlay = document.getElementById('mobile-menu-overlay');
          
          if (menu.classList.contains('-translate-x-full')) {
            // Open menu
            menu.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            // Small delay to allow display:block to apply before animating opacity
            setTimeout(() => {
              overlay.classList.add('opacity-100');
              overlay.classList.remove('opacity-0');
            }, 10);
            document.body.classList.add('overflow-hidden');
          } else {
            // Close menu
            menu.classList.add('-translate-x-full');
            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0');
            setTimeout(() => {
              overlay.classList.add('hidden');
            }, 300); // Wait for transition
            document.body.classList.remove('overflow-hidden');
          }
        }
      </script>
    <% else %>
      <main class="min-h-screen bg-zinc-950 flex flex-col">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
