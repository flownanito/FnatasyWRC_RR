<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  <div class="max-w-5xl mx-auto space-y-8">
    
    <!-- BACK BUTTON -->
    <%= link_to calendars_path, class: "inline-flex items-center gap-2 text-zinc-500 hover:text-zinc-300 transition-colors font-mono text-sm uppercase tracking-widest" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Volver al Calendario
    <% end %>

    <!-- HEADER / CARTEL OFICIAL -->
    <div class="relative w-full h-[400px] rounded-3xl overflow-hidden shadow-2xl border border-zinc-800/50 group">
      <!-- Placeholder Cartel Oficial -->
      <div class="absolute inset-0 bg-gradient-to-br from-zinc-900 to-black">
        <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #000 0, #000 2px, transparent 2px, transparent 8px);"></div>
        
        <!-- Logo / Marca de agua -->
        <div class="absolute inset-0 flex items-center justify-center opacity-5">
          <svg class="w-96 h-96 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        </div>
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
      
      <div class="absolute bottom-0 left-0 p-8 md:p-12 w-full">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-red-600 text-white text-[10px] font-bold uppercase tracking-widest rounded-sm"><%= @rally.status %></span>
              <span class="px-3 py-1 bg-zinc-800/80 backdrop-blur-sm text-zinc-300 text-[10px] font-bold uppercase tracking-widest rounded-sm border border-zinc-700/50"><%= @rally.surface %></span>
            </div>
            <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none mb-2"><%= @rally.name %></h1>
            <p class="text-xl md:text-2xl text-zinc-400 font-mono tracking-widest uppercase"><%= @rally.country %></p>
          </div>
          
          <div class="text-left md:text-right">
            <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Fechas Oficiales</p>
            <p class="text-xl font-bold text-white font-mono"><%= @rally.start_date&.strftime("%d %b") %> - <%= @rally.end_date&.strftime("%d %b %Y") %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- TECHNICAL ANALYSIS -->
    <section class="bg-zinc-900/40 shadow-xl rounded-2xl p-8 border border-zinc-800/50 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-red-500/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex items-center gap-3 mb-4">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <h2 class="text-[10px] font-mono font-bold text-red-500 uppercase tracking-widest">Análisis Técnico del Rally</h2>
      </div>
      
      <p class="text-zinc-300 text-lg leading-relaxed font-sans max-w-4xl">
        <%= rally_description(@rally) %>
      </p>
    </section>

    <!-- STAGES LIST -->
    <section>
      <div class="flex justify-between items-end mb-6 px-2">
        <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Itinerario y Meteorología (Tramos)</h2>
      </div>

      <div class="space-y-12">
        <% rally_stages_data(@rally).group_by { |s| s[:day] }.each do |day, stages| %>
          <div>
            <div class="flex items-center gap-4 mb-6">
              <h3 class="text-xl font-black text-white uppercase tracking-wider"><%= day %></h3>
              <div class="flex-1 h-px bg-zinc-800/50"></div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <% stages.each do |stage| %>
                <div class="glass-panel rounded-xl p-5 border border-zinc-800/50 relative overflow-hidden group hover:border-zinc-600 transition-colors <%= stage[:is_power_stage] ? 'ring-1 ring-orange-500/50 bg-orange-950/20' : '' %>">
                  
                  <% if stage[:is_power_stage] %>
                    <div class="absolute top-0 right-0 bg-orange-600 text-white text-[8px] font-black uppercase tracking-widest px-2 py-1 rounded-bl-lg z-10">
                      Wolf Power Stage
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-br from-orange-500/5 to-transparent pointer-events-none"></div>
                  <% end %>

                  <div class="flex justify-between items-start mb-4 relative z-10">
                    <div>
                      <h3 class="text-lg font-black text-white font-mono tracking-wider leading-tight"><%= stage[:name] %></h3>
                      <p class="text-xs text-zinc-500 font-mono mt-1"><%= stage[:length_km] %> km</p>
                    </div>
                    
                    <div class="text-3xl ml-2 shrink-0" title="<%= stage[:weather] %>">
                      <%= stage[:weather_icon] %>
                    </div>
                  </div>

                  <div class="flex justify-between items-end relative z-10">
                    <div>
                      <p class="text-[9px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Predicción</p>
                      <p class="text-sm font-bold text-zinc-300"><%= stage[:weather] %></p>
                    </div>
                    <div class="text-right">
                      <p class="text-[9px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Estado Pista</p>
                      <p class="text-sm font-bold <%= @rally.surface == 'tarmac' ? 'text-red-400' : (@rally.surface == 'snow' ? 'text-blue-300' : 'text-amber-600') %>">
                        <%= stage[:track_info] %>
                      </p>
                    </div>
                  </div>
                  
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

  </div>
</div>
