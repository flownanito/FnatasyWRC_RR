<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  
  <!-- SETTINGS HEADER -->
  <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl mb-8 p-8 relative overflow-hidden group border-l-4 border-l-red-600 border border-zinc-200 dark:border-zinc-800/50">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none hidden dark:block" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>
    
    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse shadow-[0_0_10px_rgba(239,68,68,1)]"></div>
          <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">Preferencias</span>
        </div>
        <h1 class="text-3xl font-black text-zinc-900 dark:text-white uppercase tracking-wider">
          <%= t('settings.title') %>
        </h1>
      </div>
    </div>
  </div>

  <div class="max-w-3xl bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-8 border border-zinc-200 dark:border-zinc-800/50 relative overflow-hidden">
    <%= form_with(model: current_user, url: settings_path, method: :patch, data: { turbo: false }, class: "relative z-10 space-y-8") do |form| %>
      
      <!-- Language -->
      <div class="bg-zinc-50 dark:bg-zinc-950/80 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 focus-within:border-red-500/50 transition-colors group shadow-inner">
        <%= form.label :locale, t('settings.language_label'), class: "block text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-3 group-focus-within:text-red-600 dark:group-focus-within:text-red-400 transition-colors" %>
        <div class="relative">
          <%= form.select :locale, 
                options_for_select([['Español', 'es'], ['English', 'en']], current_user.locale || 'es'),
                {},
                { class: "block w-full bg-white dark:bg-zinc-900/50 border border-zinc-300 dark:border-zinc-700/50 text-zinc-900 dark:text-white rounded py-3 pl-4 pr-10 focus:outline-none focus:ring-1 focus:ring-red-500 focus:border-red-500 sm:text-sm appearance-none font-mono tracking-wide" } %>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <!-- Theme -->
      <div class="bg-zinc-50 dark:bg-zinc-950/80 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 transition-colors group shadow-inner relative">
        <div class="block text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-3"><%= t('settings.theme_label') %></div>
        
        <div class="flex flex-col md:flex-row gap-4">
          <!-- Dark Mode -->
          <label class="flex-1 cursor-pointer relative">
            <%= form.radio_button :theme, 'dark', class: "peer sr-only" %>
            <div class="p-4 rounded-lg border border-zinc-300 dark:border-zinc-700 peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-500/10 text-center transition-all bg-white dark:bg-zinc-900">
              <span class="block text-sm font-bold text-zinc-900 dark:text-white mb-1 uppercase tracking-wider"><%= t('settings.dark_mode') %></span>
            </div>
            <div class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full opacity-0 peer-checked:opacity-100 shadow-[0_0_8px_rgba(239,68,68,1)] transition-opacity"></div>
          </label>

          <!-- Light Mode -->
          <label class="flex-1 cursor-pointer relative">
            <%= form.radio_button :theme, 'light', class: "peer sr-only" %>
            <div class="p-4 rounded-lg border border-zinc-300 dark:border-zinc-700 peer-checked:border-red-500 peer-checked:bg-red-50 dark:peer-checked:bg-red-500/10 text-center transition-all bg-white dark:bg-zinc-900">
              <span class="block text-sm font-bold text-zinc-900 dark:text-white mb-1 uppercase tracking-wider"><%= t('settings.light_mode') %></span>
            </div>
            <div class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full opacity-0 peer-checked:opacity-100 shadow-[0_0_8px_rgba(239,68,68,1)] transition-opacity"></div>
          </label>
        </div>
      </div>

      <div class="pt-4 flex justify-end">
        <%= form.submit t('settings.save'), class: "cursor-pointer bg-red-600 hover:bg-red-500 text-white py-3 px-10 border border-transparent shadow-[0_0_20px_rgba(239,68,68,0.3)] text-xs font-mono font-black uppercase tracking-[0.2em] transition-all hover:shadow-[0_0_30px_rgba(239,68,68,0.5)] rounded" %>
      </div>

    <% end %>
  </div>
</div>
