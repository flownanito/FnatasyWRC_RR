<div class="p-8 opacity-0 animate-fade-in-up">
  <div class="mb-10 relative border-b border-zinc-800/80 pb-6">
    <div class="flex justify-between items-end">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1.5 h-6 bg-orange-600 rounded-sm"></div>
          <h1 class="text-3xl font-light text-zinc-100 tracking-wide uppercase">DRIVER <span class="font-bold">MARKET</span></h1>
        </div>
        <p class="text-zinc-500 text-xs uppercase tracking-[0.2em] ml-4">Official WRC Transfer Window</p>
      </div>
      
      <div class="bg-zinc-900/50 border border-zinc-800 rounded-lg px-6 py-3 flex items-center gap-4">
        <div class="w-8 h-8 rounded-full bg-zinc-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="flex flex-col">
          <span class="text-[9px] text-zinc-500 uppercase tracking-widest font-semibold mb-0.5">Available Budget</span>
          <span class="text-xl font-mono text-zinc-200">
            <%= number_to_currency(current_user.budget, precision: 0, unit: "$") %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 mb-6 border-b border-zinc-800/80 pb-3">
    <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
    <h2 class="text-xs font-semibold text-zinc-400 tracking-[0.15em] uppercase">Active Driver Database</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12">
    <% @drivers.each_with_index do |driver, index| %>
      <div class="relative rounded-2xl overflow-hidden hover:scale-105 hover:z-10 transition-all duration-300 group opacity-0 animate-fade-in-up h-full flex flex-col shadow-[0_0_15px_rgba(0,0,0,0.5)] border-2 border-transparent hover:border-yellow-500/50" style="animation-delay: <%= (index * 50) % 500 %>ms; background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);">
        
        <!-- Animated Background Glow -->
        <div class="absolute inset-0 bg-gradient-to-tr from-yellow-500/10 via-transparent to-red-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div class="p-4 flex-1 flex flex-col relative z-10">
          
          <!-- Top Section: Rating & Logo -->
          <div class="flex justify-between items-start">
            <div class="flex flex-col items-center">
              <span class="text-3xl font-black text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-none"><%= driver.overall_rating || 85 %></span>
              <span class="text-[9px] font-bold text-yellow-500 uppercase tracking-widest mt-1"><%= driver.category %></span>
            </div>
            
            <div class="flex flex-col items-end gap-2">
              <% if driver.team&.logo.present? %>
                <div class="w-8 h-8 flex items-center justify-center">
                  <img src="<%= driver.team.logo %>" class="max-w-full max-h-full object-contain filter drop-shadow-md opacity-80 group-hover:opacity-100 transition-opacity" alt="Team">
                </div>
              <% end %>
              
              <% if driver.full_time? %>
                <span class="px-2 py-0.5 bg-green-500/20 text-green-400 text-[8px] font-bold uppercase tracking-widest border border-green-500/30 rounded-full shadow-[0_0_10px_rgba(34,197,94,0.2)]">Full Season</span>
              <% else %>
                <span class="px-2 py-0.5 bg-orange-500/20 text-orange-400 text-[8px] font-bold uppercase tracking-widest border border-orange-500/30 rounded-full shadow-[0_0_10px_rgba(249,115,22,0.2)]">Partial</span>
              <% end %>
            </div>
          </div>

          <!-- Driver Image Cutout -->
          <div class="mt-2 flex-1 flex items-center justify-center min-h-[140px] relative overflow-hidden rounded-lg mx-2">
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a] via-transparent to-transparent z-20 pointer-events-none"></div>
            <% if driver.image_url.present? %>
              <%= image_tag driver.image_url, class: "w-full h-[160px] object-cover object-center opacity-90 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500 relative z-10", alt: driver.name %>
            <% else %>
              <div class="text-6xl text-zinc-800 font-black opacity-50 drop-shadow-lg relative z-10">?</div>
            <% end %>
          </div>

          <!-- Name Divider -->
          <div class="w-full h-px bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent my-3"></div>
          
          <h3 class="font-black text-lg text-center text-white uppercase tracking-wider truncate drop-shadow-md mb-3"><%= driver.name %></h3>
          
          <!-- FIFA Stats Grid -->
          <div class="grid grid-cols-3 gap-2 text-center mb-4">
            <div class="flex flex-col">
              <span class="text-lg font-black text-white"><%= driver.pace || 80 %></span>
              <span class="text-[9px] text-zinc-500 font-bold uppercase">PAC</span>
            </div>
            <div class="flex flex-col border-x border-zinc-800">
              <span class="text-lg font-black text-white"><%= driver.consistency || 80 %></span>
              <span class="text-[9px] text-zinc-500 font-bold uppercase">CON</span>
            </div>
            <div class="flex flex-col">
              <span class="text-lg font-black text-white"><%= driver.experience || 80 %></span>
              <span class="text-[9px] text-zinc-500 font-bold uppercase">EXP</span>
            </div>
          </div>
          
          <!-- Market Value -->
          <div class="mt-auto pt-3 border-t border-zinc-800/80 flex justify-between items-center bg-black/20 -mx-4 -mb-4 px-4 pb-4 pt-3">
            <span class="text-[10px] text-zinc-400 uppercase tracking-wider font-bold">Valor</span>
            <span class="font-mono font-black text-green-400 text-base"><%= number_to_currency(driver.price, unit: '€', precision: 0) %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3 mb-6 border-b border-zinc-800/80 pb-3 mt-12">
    <svg class="w-4 h-4 text-orange-600 drop-shadow-[0_0_5px_rgba(234,88,12,0.4)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
    <h2 class="text-xs font-semibold text-zinc-400 tracking-[0.15em] uppercase">Vehículos WRC</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-12">
    <% @cars.each_with_index do |car, index| %>
      <div class="glass-panel rounded-2xl overflow-hidden hover:shadow-[0_0_25px_rgba(249,115,22,0.2)] hover:border-orange-500/50 transition-all group opacity-0 animate-fade-in-up h-full flex flex-col" style="animation-delay: <%= (index * 50) % 500 %>ms">
        <div class="p-5 flex-1 flex flex-col">
          <div class="mb-4">
            <h3 class="font-bold text-lg text-white group-hover:text-orange-400 transition-colors truncate"><%= car.name %></h3>
            <p class="text-xs text-zinc-500 uppercase tracking-widest mt-1 truncate"><%= car.team&.name || 'Independiente' %></p>
          </div>
          
          <div class="flex justify-between items-center mb-2">
            <span class="text-xs text-zinc-400 uppercase tracking-wider">Rendimiento</span>
            <div class="flex gap-1">
              <% car.performance_bonus.times do %>
                <div class="w-2 h-4 bg-orange-500 rounded-sm shadow-[0_0_5px_rgba(249,115,22,0.8)]"></div>
              <% end %>
              <% (5 - car.performance_bonus).times do %>
                <div class="w-2 h-4 bg-zinc-800/80 rounded-sm"></div>
              <% end %>
            </div>
          </div>
          
          <div class="mt-auto pt-4 border-t border-zinc-800/50 flex justify-between items-center relative">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>
            <span class="text-xs text-zinc-500 uppercase tracking-wider font-bold">Valor de Mercado</span>
            <span class="font-mono font-bold text-green-400 text-lg group-hover:scale-110 transition-transform origin-right"><%= number_to_currency(car.price, unit: '€', precision: 0) %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
