<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  
  <%= render 'shared/page_header', 
        watermark_text: 'HUB',
        seal_text: 'HQ',
        department_text: 'WRC Global Hub',
        subtitle: 'Visión General del Sistema',
        title: 'GLOBAL DASHBOARD',
        description: 'Gestión multiligas y acceso a los servidores de competición.',
        right_label_1: 'Manager',
        right_value_1: @user.username || @user.email.split('@').first,
        right_label_2: 'Global Points',
        right_value_2: @user.points || 0,
        right_badge_class: 'bg-zinc-800 text-white border-zinc-700'
  %>

  <div class="grid grid-cols-1 gap-8">
    
    <!-- LEAGUES HUB -->
    <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 opacity-0 animate-fade-in-up delay-100 border border-zinc-200 dark:border-zinc-800/50">
      <div class="flex justify-between items-end mb-6 border-b border-zinc-200 dark:border-zinc-800/50 pb-4">
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] block"><%= t('dashboard.your_leagues') %></span>
        <%= link_to t('dashboard.create_league'), new_league_path, class: "text-[10px] font-mono font-bold text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white uppercase tracking-widest transition-colors border border-zinc-300 dark:border-zinc-700 px-3 py-2 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
      </div>
      
      <% if @leagues.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          <% @leagues.each do |league| %>
            <%= link_to dashboard_league_path(league), class: "block bg-zinc-50 dark:bg-zinc-950/40 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-6 hover:border-red-600/50 dark:hover:border-red-600/50 hover:bg-zinc-100 dark:hover:bg-zinc-900/60 transition-all group relative overflow-hidden" do %>
              <div class="absolute right-0 top-0 w-24 h-24 bg-red-500/5 rounded-bl-full group-hover:bg-red-500/10 transition-colors"></div>
              
              <div class="relative z-10 flex flex-col h-full justify-between">
                <div>
                  <div class="flex justify-between items-start mb-4">
                    <span class="font-black text-xl text-zinc-900 dark:text-zinc-200 uppercase tracking-wider group-hover:text-red-600 dark:group-hover:text-white"><%= league.name %></span>
                    <svg class="w-5 h-5 text-zinc-400 dark:text-zinc-600 group-hover:text-red-500 dark:group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </div>
                  
                  <% member = league.league_members.find_by(user_id: @user.id) %>
                  <div class="flex gap-4">
                    <div class="flex flex-col">
                      <span class="text-[9px] text-zinc-500 font-mono uppercase tracking-widest"><%= t('dashboard.points') %></span>
                      <span class="font-bold text-zinc-900 dark:text-white"><%= member&.total_points || 0 %></span>
                    </div>
                    <div class="flex flex-col border-l border-zinc-200 dark:border-zinc-800 pl-4">
                      <span class="text-[9px] text-zinc-500 font-mono uppercase tracking-widest"><%= t('dashboard.budget') %></span>
                      <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono"><%= number_to_currency(member&.budget || 0, unit: '€', precision: 0) %></span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="py-12 text-center bg-zinc-50 dark:bg-zinc-950/30 rounded-xl border border-zinc-200 dark:border-zinc-800/50">
          <p class="text-zinc-600 font-mono text-xs tracking-widest uppercase mb-2">No estás apuntado a ninguna liga.</p>
          <p class="text-[10px] text-zinc-500 font-mono mb-6">Crea o únete a una liga para empezar a jugar.</p>
          <%= link_to "UNIRSE / CREAR LIGA", new_league_path, class: "inline-block px-6 py-3 border border-red-500 text-[10px] font-bold font-mono rounded-lg text-red-700 dark:text-red-100 bg-red-100 dark:bg-red-600/20 hover:bg-red-600 hover:text-white uppercase tracking-[0.2em] transition-all" %>
        </div>
      <% end %>
    </div>
    
    <!-- Enlace sutil a Términos y Condiciones -->
    <div class="mt-8 text-center pb-4">
      <%= link_to terms_and_conditions_path, class: "inline-flex items-center gap-2 text-[10px] font-mono tracking-widest text-zinc-400 dark:text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors uppercase" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        Términos, Condiciones y Privacidad (FIA T&C)
      <% end %>
    </div>
  </div>
</div>
