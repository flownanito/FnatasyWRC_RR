<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  
  <%= render 'shared/page_header', 
        watermark_text: 'CALENDAR',
        seal_text: 'WRC',
        department_text: 'Global Calendar',
        subtitle: 'Championship Stages',
        title: 'CALENDARIO DE RALLIES',
        description: 'Visualiza todos los eventos y su estado actual.',
        right_label_1: 'Total Events',
        right_value_1: @rallies.count,
        right_label_2: 'Status',
        right_value_2: 'CONFIRMED',
        right_badge_class: 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-400 border-emerald-300 dark:border-emerald-800'
  %>

  <div class="space-y-6">
    <% @rallies.each_with_index do |rally, index| %>
      <div class="glass-panel rounded-xl overflow-hidden opacity-0 animate-fade-in-up border-l-2 transition-all hover:-translate-y-1 hover:shadow-[0_0_30px_rgba(239,68,68,0.1)] <%= rally.ongoing? ? 'border-l-red-500 shadow-[0_0_20px_rgba(239,68,68,0.1)]' : (rally.finished? ? 'border-l-zinc-600' : 'border-l-zinc-800') %>" style="animation-delay: <%= (index * 100) % 1000 %>ms">
        <div class="flex flex-col md:flex-row items-stretch">
          
          <!-- Date / Status Block -->
          <div class="bg-zinc-950/60 p-6 md:w-64 flex flex-col justify-center border-r border-zinc-800/50">
            <div class="flex items-center gap-2 mb-3">
              <% if rally.ongoing? %>
                <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse shadow-[0_0_8px_rgba(239,68,68,1)]"></div>
                <span class="text-[10px] font-mono text-red-400 uppercase tracking-[0.2em] font-bold">Live</span>
              <% elsif rally.finished? %>
                <div class="w-2 h-2 rounded-full bg-zinc-600"></div>
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">Completed</span>
              <% else %>
                <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
                <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-[0.2em]">Pending</span>
              <% end %>
            </div>
            <span class="font-mono text-zinc-300 text-sm mb-1"><%= rally.start_date&.strftime("%d %b") %></span>
            <span class="font-mono text-zinc-500 text-xs">— <%= rally.end_date&.strftime("%d %b %Y") %></span>
          </div>

          <!-- Stage Details -->
          <div class="p-6 flex-1 flex flex-col justify-center relative group">
            <div class="absolute inset-0 bg-gradient-to-r from-red-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
            
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-2xl font-black text-white uppercase tracking-wider group-hover:text-red-400 transition-colors">
                <%= rally.name %>
              </h3>
              <span class="px-2 py-1 bg-zinc-950/80 border border-zinc-800/50 text-[10px] font-mono uppercase text-zinc-400 rounded shadow-inner ml-4 whitespace-nowrap">
                <%= rally.surface %>
              </span>
            </div>
            
            <div class="flex items-center gap-4 mt-2">
              <div class="flex items-center gap-2 text-zinc-400 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span class="uppercase tracking-widest text-xs font-bold"><%= rally.country %></span>
              </div>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
