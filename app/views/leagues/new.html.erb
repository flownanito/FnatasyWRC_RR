<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  <div class="glass-panel rounded-2xl max-w-2xl mx-auto p-8 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>
    
    <div class="relative z-10">
      <h1 class="text-3xl font-black uppercase text-white tracking-wider mb-2 border-b border-zinc-800/50 pb-4">
        <span class="text-orange-500">INITIALIZE</span> AFFILIATION
      </h1>
      <p class="text-zinc-400 font-mono text-xs mb-8 uppercase tracking-widest">Create a private league to compete against other managers</p>

      <%= form_with(model: @league, class: "space-y-6") do |f| %>
        <% if @league.errors.any? %>
          <div class="bg-red-950/40 border-2 border-red-600 rounded-lg p-6 mb-6 shadow-[0_0_20px_rgba(220,38,38,0.3)] relative overflow-hidden flex items-start gap-5 group">
            <div class="absolute inset-0 bg-red-600/10 animate-pulse pointer-events-none"></div>
            <!-- Warning Icon (Check Engine Light) -->
            <div class="text-orange-500 shrink-0 drop-shadow-[0_0_10px_rgba(249,115,22,0.8)] relative z-10 pt-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" class="w-12 h-12 animate-pulse">
                <!-- Check Engine Light SVG Path -->
                <path d="M482.3 192c-8.8 0-16 7.2-16 16v80c0 8.8 7.2 16 16 16h13.7c8.8 0 16-7.2 16-16v-80c0-8.8-7.2-16-16-16H482.3zM16 192c-8.8 0-16 7.2-16 16v80c0 8.8 7.2 16 16 16h13.7c8.8 0 16-7.2 16-16v-80c0-8.8-7.2-16-16-16H16zM384 128V80c0-26.5-21.5-48-48-48H176c-26.5 0-48 21.5-48 48v48H96c-17.7 0-32 14.3-32 32v192c0 17.7 14.3 32 32 32h24v32c0 17.7 14.3 32 32 32h32c17.7 0 32-14.3 32-32v-32h112v32c0 17.7 14.3 32 32 32h32c17.7 0 32-14.3 32-32v-32h24c17.7 0 32-14.3 32-32V160c0-17.7-14.3-32-32-32h-32zM288 128h-64V80h64v48zM192 128h-16V80h16v48zm144 0h-16V80h16v48z"/>
              </svg>
            </div>
            <div class="relative z-10">
              <p class="text-orange-500 font-black font-mono text-lg uppercase tracking-[0.2em] mb-2 drop-shadow-[0_0_5px_rgba(249,115,22,0.5)]">FALLO DE MOTOR</p>
              <ul class="text-orange-300 font-mono text-xs list-none space-y-2 uppercase tracking-widest">
                <% @league.errors.full_messages.each do |msg| %>
                  <li class="flex items-start gap-2">
                    <span class="text-orange-500 mt-0.5">▶</span>
                    <span><%= msg %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "AFFILIATION NAME", class: "block text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] mb-2" %>
          <%= f.text_field :name, class: "w-full bg-zinc-900/50 border border-zinc-700/50 rounded p-3 text-white font-mono focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none transition-colors", placeholder: "e.g. WRC Elite Club" %>
        </div>

        <div class="pt-6 border-t border-zinc-800/50 flex justify-end gap-4">
          <%= link_to "ABORT", root_path, class: "px-6 py-3 border border-zinc-700 rounded text-xs font-bold font-mono uppercase tracking-widest text-zinc-400 hover:bg-zinc-800 hover:text-white transition-colors" %>
          <%= f.submit "CREATE LEAGUE", class: "px-8 py-3 bg-orange-600 hover:bg-orange-500 text-white font-bold font-mono text-xs rounded uppercase tracking-[0.2em] shadow-[0_0_15px_rgba(234,88,12,0.4)] hover:shadow-[0_0_25px_rgba(234,88,12,0.6)] transition-all cursor-pointer" %>
        </div>
      <% end %>

      <!-- JOIN FORM -->
      <div class="mt-12 pt-12 border-t border-zinc-800/80">
        <h2 class="text-2xl font-black uppercase text-white tracking-wider mb-2">
          <span class="text-emerald-500">JOIN</span> EXISTING AFFILIATION
        </h2>
        <p class="text-zinc-400 font-mono text-xs mb-8 uppercase tracking-widest">Enter an access code to join a private league (Max 5 Players)</p>

        <%= form_with(url: join_leagues_path, method: :post, class: "space-y-6") do |f| %>
          <div>
            <%= f.label :code, "ACCESS CODE", class: "block text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] mb-2" %>
            <%= f.text_field :code, class: "w-full bg-zinc-900/50 border border-zinc-700/50 rounded p-3 text-emerald-400 font-mono focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-colors uppercase tracking-widest", placeholder: "e.g. A1B2C3D4" %>
          </div>

          <div class="pt-6 border-t border-zinc-800/50 flex justify-end gap-4">
            <%= f.submit "JOIN LEAGUE", class: "px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold font-mono text-xs rounded uppercase tracking-[0.2em] shadow-[0_0_15px_rgba(16,185,129,0.4)] hover:shadow-[0_0_25px_rgba(16,185,129,0.6)] transition-all cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
