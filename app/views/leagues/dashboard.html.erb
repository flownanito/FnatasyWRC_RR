<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  <%= render 'shared/page_header', 
        watermark_text: 'TELEMETRY',
        seal_text: 'WRC',
        department_text: 'Live Ranking & Telemetry',
        subtitle: 'Panel de Jefe de Equipo',
        title: "LIGA: #{@league.name}",
        description: 'Métricas, finanzas y rendimiento global de la escudería.',
        right_label_1: 'Manager',
        right_value_1: current_user.username || current_user.email.split('@').first,
        right_label_2: 'Status',
        right_value_2: 'ONLINE',
        right_badge_class: 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-400 border-emerald-300 dark:border-emerald-800',
        extra_right_content: capture { %>
          <span class="block text-[8px] font-mono text-zinc-500 uppercase tracking-widest mb-1">Código Inv.</span>
          <div class="flex items-center gap-2">
            <span class="text-sm font-black font-mono text-zinc-900 dark:text-white"><%= @league.code %></span>
            <button onclick="navigator.clipboard.writeText('<%= @league.code %>')" class="text-zinc-500 hover:text-red-600 transition-colors">
              <i class="fa-solid fa-copy"></i>
            </button>
          </div>
        <% } %>

  <!-- ACTION BAR -->
  <div class="mb-8 flex justify-end gap-4">
    <%= link_to "MERCADO DE FICHAJES", market_league_path(@league), class: "px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold font-mono text-xs rounded uppercase tracking-[0.2em] shadow-[0_0_15px_rgba(16,185,129,0.4)] hover:shadow-[0_0_25px_rgba(16,185,129,0.6)] transition-all" %>
  </div>

  <!-- MAIN CONTENT -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- LEFT COLUMN -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- CLASIFICACIÓN -->
      <section class="opacity-0 animate-fade-in-up delay-100">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Clasificación Global</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50">
          <div class="space-y-3">
            <% @members.each_with_index do |member, index| %>
              <div class="flex items-center justify-between p-4 rounded-xl <%= member == @current_member ? 'bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30' : 'bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800' %>">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full <%= member == @current_member ? 'bg-red-100 dark:bg-red-500/20 text-red-600 dark:text-red-400' : 'bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400' %> flex items-center justify-center font-bold text-sm">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-900 dark:text-white"><%= member.user.username || member.user.email.split('@').first %></p>
                    <p class="text-xs text-zinc-500 font-mono">
                      <%= member == @current_member ? "TÚ" : "RIVAL" %>
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-xl font-black text-zinc-900 dark:text-white font-mono"><%= member.total_points %></p>
                  <p class="text-[9px] uppercase tracking-widest text-zinc-500">Puntos</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <!-- TU EQUIPO / ALINEACION -->
      <% if @current_rally %>
        <section class="opacity-0 animate-fade-in-up delay-200">
          <div class="flex justify-between items-end mb-4 px-2">
            <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Siguiente Evento</h2>
          </div>
          
          <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-black text-zinc-900 dark:text-white uppercase tracking-wider"><%= @current_rally.name %></h2>
              <% if @lineup %>
                <%= link_to "EDITAR SETUP", edit_league_fantasy_lineup_path(@league, @lineup), class: "text-[10px] font-mono font-bold text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white uppercase tracking-widest transition-colors border border-zinc-300 dark:border-zinc-700 px-3 py-2 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
              <% else %>
                <%= link_to "CONFIGURAR SETUP", new_league_fantasy_lineup_path(@league, rally_id: @current_rally.id), class: "text-[10px] font-mono font-bold text-red-600 dark:text-red-400 uppercase tracking-widest transition-colors border border-red-500/50 px-3 py-2 rounded bg-red-50 dark:bg-red-500/10 hover:bg-red-100 dark:hover:bg-red-500/20" %>
              <% end %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4">
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] block mb-2">Tus Pilotos (Fichajes)</span>
                <% if @my_drivers.any? %>
                  <div class="flex gap-4">
                    <% @my_drivers.each do |driver| %>
                      <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400 uppercase"><%= driver.name %></div>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs text-zinc-500 dark:text-zinc-600 font-mono italic">No has fichado a ningún piloto.</span>
                <% end %>
              </div>

              <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4">
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] block mb-2">Tu Setup Configurado</span>
                <% if @lineup %>
                  <div class="flex flex-col gap-1">
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Vehículo: <span class="text-zinc-900 dark:text-white"><%= @lineup.car&.name %></span></div>
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Ingeniero: <span class="text-zinc-900 dark:text-white"><%= @lineup.engineer&.name %></span></div>
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Sponsor: <span class="text-zinc-900 dark:text-white"><%= @lineup.sponsor&.name %></span></div>
                  </div>
                <% else %>
                  <span class="text-xs text-red-600 dark:text-red-500 font-mono italic">Falta configurar Coche e Ingeniero.</span>
                <% end %>
              </div>
            </div>
          </div>
        </section>
      <% end %>

      <!-- PANEL DE MÉTRICAS DEL JEFE DE EQUIPO -->
      <section class="opacity-0 animate-fade-in-up delay-300">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Team Performance Metrics</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50">
          <% 
            # Real Metrics Calculations
            
            # 1. League Rank & Leader Gap
            sorted_members = @members.to_a.sort_by { |m| -(m.total_points || 0) }
            rank = sorted_members.index(@current_member) ? sorted_members.index(@current_member) + 1 : 0
            leader_points = sorted_members.first&.total_points || 0
            my_points = @current_member.total_points || 0
            gap_to_leader = leader_points - my_points

            # 2. Team Value Calculation
            drivers_value = @my_drivers.sum { |d| d.price || 0 }
            car_value = @lineup&.car&.price || 0
            engineer_value = @lineup&.engineer&.price || 0
            team_value = drivers_value + car_value + engineer_value

            # 3. Budget
            budget = @current_member.budget || 0

            # Autoestima Funcional (basada en posición en liga)
            if rank == 1
              esteem_status = "LÍDERES (INQUEBRANTABLE)"
              esteem_color = "text-emerald-500"
              esteem_bg = "bg-emerald-500"
            elsif gap_to_leader <= 25
              esteem_status = "A LA CAZA (MOTIVADOS)"
              esteem_color = "text-blue-500"
              esteem_bg = "bg-blue-500"
            else
              esteem_status = "BAJO PRESIÓN"
              esteem_color = "text-red-500"
              esteem_bg = "bg-red-500"
            end

            # Estilo / Enfoque Funcional
            if gap_to_leader > 50
              style = "AGRESIVO (ARRIESGAR)"
            elsif rank == 1
              style = "CONSERVADOR (MANTENER)"
            else
              style = "EQUILIBRADO"
            end

            # Moral / Utilización de Recursos
            total_assets = team_value + budget
            moral_val = total_assets > 0 ? ((team_value.to_f / total_assets) * 100).to_i : 0
            moral_val = [moral_val, 100].min

            # Trend based on last lineup
            last_score = @lineup&.total_score || 0
            trend_positive = last_score > 0
          %>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            
            <!-- Posición Actual -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Posición Liga</span>
              <span class="text-xl font-black text-zinc-900 dark:text-white uppercase tracking-wider">#<%= rank %></span>
            </div>

            <!-- Gap to Leader -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Distancia al Líder</span>
              <span class="text-xl font-black text-zinc-900 dark:text-zinc-300 uppercase tracking-wide">-<%= gap_to_leader %> PTS</span>
            </div>

            <!-- Autoestima -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Autoestima</span>
              <span class="text-xs font-black <%= esteem_color %> uppercase tracking-wider"><%= esteem_status %></span>
            </div>

            <!-- Estilo / Enfoque -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Enfoque Actual</span>
              <span class="text-xs font-bold text-zinc-900 dark:text-zinc-300 uppercase tracking-wide"><%= style %></span>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            <!-- Valor Total del Equipo -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Valor Fichajes</span>
              <span class="text-lg font-black text-blue-500 font-mono"><%= number_to_currency(team_value, unit: "€", precision: 0) %></span>
            </div>

            <!-- Moral / Inversión de Recursos -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <div class="flex justify-between w-full mb-2">
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">Recursos Invertidos</span>
                <span class="text-[10px] text-zinc-400 font-mono"><%= moral_val %>%</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-1.5 mt-1 overflow-hidden">
                <div class="<%= esteem_bg %> h-1.5 rounded-full transition-all duration-1000" style="width: <%= moral_val %>%"></div>
              </div>
            </div>

            <!-- Tendencia de Último Evento -->
            <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4 flex flex-col justify-center items-center text-center group hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
              <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2">Último Desempeño</span>
              <% if trend_positive %>
                <div class="flex items-center gap-1 text-emerald-500">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                  <span class="text-xs font-bold font-mono">+<%= last_score %> PTS</span>
                </div>
              <% else %>
                <div class="flex items-center gap-1 text-zinc-500">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"></path></svg>
                  <span class="text-xs font-bold font-mono">0 PTS</span>
                </div>
              <% end %>
            </div>

          </div>

          <!-- Gráfica de Progreso de Liga Simulado con Datos Reales -->
          <div class="mt-6 pt-6 border-t border-zinc-200 dark:border-zinc-800/50">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-4 block">Evolución Puntos Totales (Tú vs Líder)</span>
            <div class="flex flex-col gap-3 w-full px-2">
              <!-- Tú -->
              <div class="flex items-center gap-3">
                <span class="text-[10px] text-zinc-400 font-mono w-12">TÚ</span>
                <div class="flex-1 bg-zinc-100 dark:bg-zinc-800/50 rounded-sm relative h-4">
                  <div class="absolute top-0 left-0 h-full <%= esteem_bg %> rounded-sm transition-all duration-500" style="width: <%= leader_points > 0 ? (my_points.to_f / leader_points * 100).to_i : 0 %>%"></div>
                </div>
                <span class="text-[10px] text-white font-mono font-bold"><%= my_points %></span>
              </div>
              <!-- Líder -->
              <div class="flex items-center gap-3">
                <span class="text-[10px] text-zinc-400 font-mono w-12">LÍDER</span>
                <div class="flex-1 bg-zinc-100 dark:bg-zinc-800/50 rounded-sm relative h-4">
                  <div class="absolute top-0 left-0 h-full bg-zinc-400 rounded-sm transition-all duration-500" style="width: 100%"></div>
                </div>
                <span class="text-[10px] text-white font-mono font-bold"><%= leader_points %></span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="space-y-8">
      
      <!-- POINTS COUNTER -->
      <section class="opacity-0 animate-fade-in-up delay-150">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Live Points Counter</h2>
        </div>
        
        <div class="bg-gradient-to-br from-zinc-900 to-zinc-800 dark:from-zinc-950 dark:to-zinc-900 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-700 dark:border-zinc-800 flex flex-col justify-center items-center">
          <div class="absolute -top-10 -right-10 w-32 h-32 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="text-center w-full relative z-10">
            <p class="text-[10px] text-zinc-400 font-mono uppercase tracking-[0.2em] mb-2">Total Campeonato</p>
            <div class="flex items-baseline justify-center gap-2">
              <span class="text-5xl font-black text-white font-mono tracking-tighter"><%= @current_member.total_points || 0 %></span>
              <span class="text-sm font-bold text-blue-400 font-mono">PTS</span>
            </div>
          </div>
          
          <% if @current_rally && @current_rally.status == 'ongoing' %>
          <div class="w-full border-t border-zinc-700/50 my-6"></div>
          
          <div class="text-center w-full relative z-10 flex justify-between items-center px-4">
            <div class="text-left">
              <p class="text-[9px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Rally Actual</p>
              <p class="text-xs font-bold text-zinc-300"><%= @current_rally.name %></p>
            </div>
            <div class="text-right">
              <p class="text-[9px] text-emerald-500/70 font-mono uppercase tracking-[0.2em] mb-1">Earned</p>
              <p class="text-xl font-black text-emerald-400 font-mono">+0</p>
            </div>
          </div>
          <% end %>
        </div>
      </section>

      <!-- FINANCIAL STATUS -->
      <section class="opacity-0 animate-fade-in-up delay-200">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Team Principal Metrics</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50 flex flex-col justify-center items-center h-auto space-y-6">
          <div class="text-center w-full">
            <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Presupuesto Líquido</p>
            <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(52,211,153,0.15)]"><%= number_to_currency(@total_budget, unit: '€', precision: 0) %></p>
          </div>
          
          <div class="w-full border-t border-zinc-200 dark:border-zinc-800/50"></div>
          
          <div class="text-center w-full">
            <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Valor de Plantilla (Assets)</p>
            <p class="text-2xl font-black text-zinc-900 dark:text-white font-mono"><%= number_to_currency(@team_value, unit: '€', precision: 0) %></p>
          </div>

          <div class="w-full border-t border-zinc-200 dark:border-zinc-800/50"></div>

          <div class="text-center w-full">
            <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-1">Valor Total de Franquicia</p>
            <p class="text-2xl font-black text-red-600 dark:text-red-500 font-mono"><%= number_to_currency(@total_budget + @team_value, unit: '€', precision: 0) %></p>
          </div>
          
          <div class="pt-2">
            <%= link_to market_league_path(@league), class: "inline-block px-6 py-2 border border-red-500 text-[10px] font-bold font-mono rounded-lg text-red-700 dark:text-red-100 bg-red-100 dark:bg-red-600/20 hover:bg-red-600 hover:text-white uppercase tracking-[0.2em] transition-all" do %>
              Gestionar Fichajes
            <% end %>
          </div>
        </div>
      </section>
      
      <% if @current_rally %>
      <section class="opacity-0 animate-fade-in-up delay-300">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Siguiente Acción</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50 flex flex-col justify-center items-center h-48">
          <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-4">Alineación Próximo Rally</p>
          <%= link_to new_league_fantasy_lineup_path(@league), class: "inline-block px-6 py-3 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-[10px] font-bold font-mono rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 uppercase tracking-[0.2em] transition-all shadow-md" do %>
            Configurar Setup
          <% end %>
        </div>
      </section>
      <% end %>

    </div>
  </div>
</div>
