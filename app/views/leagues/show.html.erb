<div class="min-h-screen p-8 opacity-0 animate-fade-in-up">
  <!-- LEAGUE HEADER -->
  <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl mb-8 p-8 relative overflow-hidden group border-l-4 border-l-red-600 border border-zinc-200 dark:border-zinc-800/50">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none hidden dark:block" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>
    
    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center">
      <div class="mb-6 md:mb-0">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1.5 h-6 bg-red-600 rounded-sm"></div>
          <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em]">Live Ranking</span>
        </div>
        <h1 class="text-3xl font-black text-zinc-900 dark:text-white uppercase tracking-wider">
          LIGA: <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-orange-500 dark:from-red-500 dark:to-orange-400"><%= @league.name %></span>
        </h1>
      </div>
      
      <div class="flex flex-col items-end">
        <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-1">Código de Invitación</span>
        <div class="bg-zinc-100 dark:bg-black/40 px-4 py-2 rounded border border-zinc-200 dark:border-zinc-800 flex items-center gap-3">
          <span class="text-2xl font-black font-mono text-zinc-900 dark:text-white drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(255,255,255,0.2)]"><%= @league.code %></span>
          <button onclick="navigator.clipboard.writeText('<%= @league.code %>')" class="text-zinc-500 hover:text-red-600 dark:hover:text-red-400 transition-colors" title="Copiar código">
            <i class="fa-solid fa-copy"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ACTION BAR -->
  <div class="mb-8 flex justify-end gap-4">
    <%= link_to "MERCADO DE FICHAJES", market_league_path(@league), class: "px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold font-mono text-xs rounded uppercase tracking-[0.2em] shadow-[0_0_15px_rgba(16,185,129,0.4)] hover:shadow-[0_0_25px_rgba(16,185,129,0.6)] transition-all" %>
  </div>

  <!-- MAIN CONTENT -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- LEFT COLUMN -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- CLASIFICACIÓN -->
      <section class="opacity-0 animate-fade-in-up delay-100">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Clasificación Global</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50">
          <div class="space-y-3">
            <% @members.each_with_index do |member, index| %>
              <div class="flex items-center justify-between p-4 rounded-xl <%= member == @current_member ? 'bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30' : 'bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800' %>">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full <%= member == @current_member ? 'bg-red-100 dark:bg-red-500/20 text-red-600 dark:text-red-400' : 'bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400' %> flex items-center justify-center font-bold text-sm">
                    <%= index + 1 %>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-900 dark:text-white"><%= member.user.username || member.user.email.split('@').first %></p>
                    <p class="text-xs text-zinc-500 font-mono">
                      <%= member == @current_member ? "TÚ" : "RIVAL" %>
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-xl font-black text-zinc-900 dark:text-white font-mono"><%= member.total_points %></p>
                  <p class="text-[9px] uppercase tracking-widest text-zinc-500">Puntos</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <!-- TU EQUIPO / ALINEACION -->
      <% if @current_rally %>
        <section class="opacity-0 animate-fade-in-up delay-200">
          <div class="flex justify-between items-end mb-4 px-2">
            <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Siguiente Evento</h2>
          </div>
          
          <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-black text-zinc-900 dark:text-white uppercase tracking-wider"><%= @current_rally.name %></h2>
              <% if @lineup %>
                <%= link_to "EDITAR SETUP", edit_league_fantasy_lineup_path(@league, @lineup), class: "text-[10px] font-mono font-bold text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white uppercase tracking-widest transition-colors border border-zinc-300 dark:border-zinc-700 px-3 py-2 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800" %>
              <% else %>
                <%= link_to "CONFIGURAR SETUP", new_league_fantasy_lineup_path(@league, rally_id: @current_rally.id), class: "text-[10px] font-mono font-bold text-red-600 dark:text-red-400 uppercase tracking-widest transition-colors border border-red-500/50 px-3 py-2 rounded bg-red-50 dark:bg-red-500/10 hover:bg-red-100 dark:hover:bg-red-500/20" %>
              <% end %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4">
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] block mb-2">Tus Pilotos (Fichajes)</span>
                <% if @my_drivers.any? %>
                  <div class="flex gap-4">
                    <% @my_drivers.each do |driver| %>
                      <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400 uppercase"><%= driver.name %></div>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs text-zinc-500 dark:text-zinc-600 font-mono italic">No has fichado a ningún piloto.</span>
                <% end %>
              </div>

              <div class="bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800/50 rounded-xl p-4">
                <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] block mb-2">Tu Setup Configurado</span>
                <% if @lineup %>
                  <div class="flex flex-col gap-1">
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Vehículo: <span class="text-zinc-900 dark:text-white"><%= @lineup.car&.name %></span></div>
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Ingeniero: <span class="text-zinc-900 dark:text-white"><%= @lineup.engineer&.name %></span></div>
                    <div class="text-xs font-bold text-zinc-500 dark:text-zinc-300 uppercase">Sponsor: <span class="text-zinc-900 dark:text-white"><%= @lineup.sponsor&.name %></span></div>
                  </div>
                <% else %>
                  <span class="text-xs text-red-600 dark:text-red-500 font-mono italic">Falta configurar Coche e Ingeniero.</span>
                <% end %>
              </div>
            </div>
          </div>
        </section>
      <% end %>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="space-y-8">
      <!-- FINANCIAL STATUS -->
      <section class="opacity-0 animate-fade-in-up delay-200">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Tu Estado Financiero</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50 flex flex-col justify-center items-center h-48">
          <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-2">Presupuesto Restante</p>
          <p class="text-3xl sm:text-4xl font-black text-emerald-600 dark:text-emerald-400 font-mono mb-4 drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(52,211,153,0.15)] break-words"><%= number_to_currency(@current_member.budget, unit: '€', precision: 0) %></p>
          <%= link_to market_league_path(@league), class: "inline-block px-6 py-2 border border-red-500 text-[10px] font-bold font-mono rounded-lg text-red-700 dark:text-red-100 bg-red-100 dark:bg-red-600/20 hover:bg-red-600 hover:text-white uppercase tracking-[0.2em] transition-all" do %>
            Gestionar Fichajes
          <% end %>
        </div>
      </section>
      
      <% if @current_rally %>
      <section class="opacity-0 animate-fade-in-up delay-300">
        <div class="flex justify-between items-end mb-4 px-2">
          <h2 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-widest">Siguiente Acción</h2>
        </div>
        
        <div class="bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none rounded-2xl p-6 relative overflow-hidden border border-zinc-200 dark:border-zinc-800/50 flex flex-col justify-center items-center h-48">
          <p class="text-[10px] text-zinc-500 font-mono uppercase tracking-[0.2em] mb-4">Alineación Próximo Rally</p>
          <%= link_to new_league_fantasy_lineup_path(@league), class: "inline-block px-6 py-3 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-[10px] font-bold font-mono rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 uppercase tracking-[0.2em] transition-all shadow-md" do %>
            Configurar Setup
          <% end %>
        </div>
      </section>
      <% end %>

    </div>
  </div>
</div>
