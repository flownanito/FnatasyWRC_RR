<%= form_with(model: [@league, @lineup], class: "space-y-8 bg-white dark:bg-zinc-900/40 shadow-xl dark:shadow-none p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800/50 opacity-0 animate-fade-in-up", data: { controller: "lineup", lineup_budget_value: @member.budget }) do |form| %>
  <%= form.hidden_field :rally_id, value: @rally.id %>

  <% if @lineup.errors.any? %>
    <div id="error_explanation" class="bg-red-50 dark:bg-red-950/30 border-l-4 border-l-red-500 p-6 rounded mb-8 shadow-inner">
      <h2 class="uppercase tracking-widest font-mono font-bold text-red-600 dark:text-red-400 text-sm mb-3">System Error: <%= pluralize(@lineup.errors.count, "invalid parameter") %></h2>
      <ul class="list-none space-y-1 text-sm font-mono text-zinc-600 dark:text-zinc-400">
        <% @lineup.errors.each do |error| %>
          <li class="flex items-center gap-2">
            <span class="text-red-500">-</span> <%= error.full_message %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
    <!-- Car -->
    <div class="bg-zinc-50 dark:bg-zinc-950/80 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 focus-within:border-red-500/50 transition-colors group shadow-inner">
      <%= form.label :car_id, "VEHÍCULO WRC", class: "block text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-red-600 dark:group-focus-within:text-red-400 transition-colors" %>
      <div class="relative">
        <%= form.select :car_id, 
              options_for_select(@cars.map { |c| ["#{c.name} (#{number_to_currency(c.price, unit: '€', precision: 0, format: '%u%n')})", c.id, { 'data-price' => c.price }] }, @lineup.car_id),
              { include_blank: "SELECCIONAR COCHE" },
              { class: "block w-full bg-white dark:bg-zinc-900/50 border border-zinc-300 dark:border-zinc-700/50 text-zinc-900 dark:text-white rounded py-3 pl-4 pr-10 focus:outline-none focus:ring-1 focus:ring-red-500 focus:border-red-500 sm:text-sm appearance-none font-mono tracking-wide",
                data: { lineup_target: "car", action: "change->lineup#calculate" } } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-500">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>

    <!-- Engineer -->
    <div class="bg-zinc-50 dark:bg-zinc-950/80 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 focus-within:border-red-500/50 transition-colors group shadow-inner">
      <%= form.label :engineer_id, "INGENIERO JEFE", class: "block text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-red-600 dark:group-focus-within:text-red-400 transition-colors" %>
      <div class="relative">
        <%= form.select :engineer_id, 
              options_for_select(@engineers.map { |e| ["#{e.name} (#{e.specialty}) - #{number_to_currency(e.price, unit: '€', precision: 0, format: '%u%n')}", e.id, { 'data-price' => e.price }] }, @lineup.engineer_id),
              { include_blank: "SELECCIONAR INGENIERO" },
              { class: "block w-full bg-white dark:bg-zinc-900/50 border border-zinc-300 dark:border-zinc-700/50 text-zinc-900 dark:text-white rounded py-3 pl-4 pr-10 focus:outline-none focus:ring-1 focus:ring-red-500 focus:border-red-500 sm:text-sm appearance-none font-mono tracking-wide",
                data: { lineup_target: "engineer", action: "change->lineup#calculate" } } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-500">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>

    <!-- Sponsor -->
    <div class="bg-zinc-50 dark:bg-zinc-950/80 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 focus-within:border-red-500/50 transition-colors group shadow-inner md:col-span-2">
      <%= form.label :sponsor_id, "PATROCINADOR PRINCIPAL", class: "block text-[10px] font-mono text-zinc-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-red-600 dark:group-focus-within:text-red-400 transition-colors" %>
      <div class="relative">
        <%= form.select :sponsor_id, 
              options_for_select(@sponsors.map { |s| ["#{s.name} (+#{number_to_currency(s.monetary_reward, unit: '€', precision: 0, format: '%u%n')})", s.id] }, @lineup.sponsor_id),
              { include_blank: "SELECCIONAR SPONSOR" },
              { class: "block w-full bg-white dark:bg-zinc-900/50 border border-zinc-300 dark:border-zinc-700/50 text-zinc-900 dark:text-white rounded py-3 pl-4 pr-10 focus:outline-none focus:ring-1 focus:ring-red-500 focus:border-red-500 sm:text-sm appearance-none font-mono tracking-wide" } %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-zinc-500">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Budget Summary -->
  <div class="mt-8 bg-zinc-50 dark:bg-zinc-900/50 p-6 rounded-xl border border-zinc-200 dark:border-zinc-800/50 flex flex-col md:flex-row justify-between items-center relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-500"></div>
    <div class="flex items-center gap-3 mb-2 md:mb-0 ml-4">
      <span class="font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.2em] text-xs">FONDOS DISPONIBLES EN LIGA:</span>
    </div>
    <span data-lineup-target="remaining" class="font-black text-emerald-600 dark:text-emerald-400 text-3xl font-mono tracking-tighter drop-shadow-sm dark:drop-shadow-[0_0_10px_rgba(16,185,129,0.2)]">
      <%= number_to_currency(@member.budget, unit: "€", precision: 0, format: "%u%n") %>
    </span>
  </div>

  <!-- Actions -->
  <div class="pt-8 flex justify-end gap-4 border-t border-zinc-200 dark:border-zinc-800/50">
    <%= link_to "CANCELAR", league_path(@league), class: "bg-transparent py-3 px-8 border border-zinc-300 dark:border-zinc-700 text-xs font-mono font-bold text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white uppercase tracking-[0.2em] transition-colors rounded" %>
    <%= form.submit "CONFIRMAR SETUP", data: { lineup_target: "submit" }, class: "cursor-pointer bg-red-600 hover:bg-red-500 text-white py-3 px-10 border border-transparent shadow-[0_0_20px_rgba(239,68,68,0.3)] text-xs font-mono font-black uppercase tracking-[0.2em] transition-all hover:shadow-[0_0_30px_rgba(239,68,68,0.5)] rounded" %>
  </div>
<% end %>
